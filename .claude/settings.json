{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(herd php artisan test*)",
      "Bash(herd php artisan route:list*)",
      "Bash(herd php vendor/bin/pint*)",
      "Bash(herd php vendor/bin/phpstan*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": ["Read(./.env)", "Read(./storage/*.key)", "Edit(./.env)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-secrets.mjs",
            "timeout": 10,
            "statusMessage": "Verificando segredos..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git *)",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-git.mjs",
            "timeout": 10,
            "statusMessage": "Verificando operação git..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-php.mjs",
            "timeout": 120,
            "statusMessage": "Pint + PHPStan..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-tests.mjs",
            "timeout": 300,
            "statusMessage": "Rodando a suíte...",
            "async": true
          }
        ]
      }
    ]
  }
}
